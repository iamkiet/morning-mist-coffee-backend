{
  "name": "morning-mist-coffee-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:dead": "knip",
    "check:arch": "bash .claude/check-architecture.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "db:backfill-embeddings": "tsx --env-file=.env src/backfill-embeddings.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.5",
    "@google/genai": "2.16.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "1.0.0-beta.22",
    "fastify": "5.11.3",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "6.1.0",
    "fluent-ffmpeg": "2.1.3",
    "jose": "6.2.8",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/node": "26.1.2",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "10.8.1",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
