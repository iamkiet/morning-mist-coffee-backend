NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Free tier is heavily rate-limited (as low as 20 requests/day on gemini-3.6-flash) and each
# chat/voice search costs 2-4 Gemini calls — use a paid/billed project for anything beyond local dev.
GEMINI_API_KEY=your_gemini_api_key_here
AI_GEN_GEMINI_MODEL=gemini-3.6-flash
AI_EMBEDDING_GEMINI_MODEL=gemini-embedding-2

AUTH_JWT_SECRET=replace-with-32-bytes-base64url-string-from-the-command-in-readme
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d

CORS_ORIGINS=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CUSTOMER_REGISTRATION_KEY=
EMPLOYEE_REGISTRATION_KEY=

# Public base URL of the storefront frontend — used to build links in emails (e.g. track-order)
STOREFRONT_URL=http://localhost:8196

# Set true in production (HTTPS), false in dev (http://localhost)
COOKIE_SECURE=false
# Production is now same-site (frontend + api are both subdomains of
# todaywegrind.com) — use 'lax' there too, only use 'none' if the frontend
# and backend are ever split across unrelated domains again
COOKIE_SAME_SITE=lax

# Set true in dev/staging to return real 500 messages; false in production to return generic "Internal server error"
EXPOSE_INTERNAL_ERRORS=true

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=onboarding@resend.dev

# Security Agent (ASI10 kill switch) — set false to disable all autonomous
# action (email alerts / temp IP blocks), falls back to logging only
SECURITY_AGENT_ENABLED=true
# Admin inbox that receives ALERT_EMAIL decisions from the security agent
SECURITY_AGENT_ALERT_EMAIL=admin@example.com

# gemini-embedding-2 output size. Changing this requires a new migration and a
# full re-run of db:backfill-embeddings — products.embedding is halfvec(N).
# halfvec (not vector) because pgvector caps HNSW indexes at 2000 dimensions
# for the vector type; halfvec raises that to 4000.
EMBEDDING_DIMENSION=3072

